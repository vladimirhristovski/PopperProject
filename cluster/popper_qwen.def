Bootstrap: docker
From: nvidia/cuda:12.8.1-runtime-ubuntu22.04

%labels
    Description vLLM 0.19.1 (torch 2.10.0, CUDA 12.8, needs driver 525.60 or newer) model server plus a Python 3.10 POPPER environment with the proven pins, for Qwen3.8-27B

%files
    popper_upgrade /opt/popper/popper_upgrade
    cluster /opt/popper/cluster
    baseline_experiment/config.py /opt/popper/baseline_experiment/config.py
    baseline_experiment/popper_common.py /opt/popper/baseline_experiment/popper_common.py
    data/winobias.csv /opt/popper/data/winobias.csv
    data/bbq.csv /opt/popper/data/bbq.csv
    data/stereoset.csv /opt/popper/data/stereoset.csv

%post
    rm -rf /opt/popper/popper_upgrade/app /opt/popper/popper_upgrade/tests
    mkdir -p /opt/popper/data/bio_database
    find /opt/popper/cluster/jobs -mindepth 1 -maxdepth 1 ! -name qwen-large -exec rm -rf {} +
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends git ca-certificates curl build-essential python3-pip cuda-nvcc-12-8 cuda-cudart-dev-12-8
    rm -rf /var/lib/apt/lists/*
    pip3 install uv==0.13.5
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    export UV_CACHE_DIR=/tmp/uv-cache
    export UV_LINK_MODE=copy
    uv venv --python 3.12 /opt/vllm-env
    uv pip install --python /opt/vllm-env/bin/python --torch-backend=cu128 torch==2.10.0
    uv pip install --python /opt/vllm-env/bin/python --torch-backend=cu128 vllm==0.19.1 torch==2.10.0
    uv venv --python 3.10 /opt/popper-env
    uv pip install --python /opt/popper-env/bin/python torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu
    uv pip install --python /opt/popper-env/bin/python --no-deps git+https://github.com/snap-stanford/POPPER.git@59611864e09dd15d7528e240ad87c7ddbb4a701c
    uv pip install --python /opt/popper-env/bin/python -r /opt/popper/popper_upgrade/requirements.txt
    export SENTENCE_TRANSFORMERS_HOME=/opt/popper/st
    /opt/popper-env/bin/python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"
    rm -rf /tmp/uv-cache
    chmod -R a+rX /opt/popper /opt/popper-env /opt/vllm-env /opt/uv-python

%environment
    export PYTHONPATH=/opt/popper:${PYTHONPATH:-}
    export POPPER_IMAGE=qwen
    export POPPER_VLLM_PYTHON=/opt/vllm-env/bin/python
    export SENTENCE_TRANSFORMERS_HOME=/opt/popper/st
    export HF_HOME=${POPPER_HF_HOME:-$PWD/hf_cache}
    export TRANSFORMERS_CACHE=${HF_HOME}/transformers

%runscript
    exec /opt/popper-env/bin/python -m cluster.job run "$@"

%test
    /opt/vllm-env/bin/python -c "import torch, vllm; print('vLLM:', vllm.__version__); print('CUDA:', torch.version.cuda); assert vllm.__version__ == '0.19.1' and torch.version.cuda == '12.8'"
    /opt/popper-env/bin/python -c "import torch; print('PyTorch:', torch.__version__); assert torch.__version__.startswith('2.5.1')"
    /opt/popper-env/bin/python -c "import popper; print('POPPER: OK')"
    /opt/popper-env/bin/python -c "import popper_upgrade, sentence_transformers, cluster.job"
