FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends git ca-certificates curl build-essential python3-pip cuda-nvcc-12-8 cuda-cudart-dev-12-8 \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install uv==0.13.5

RUN --mount=type=cache,target=/tmp/uv-cache \
    uv venv --python 3.12 /opt/vllm-env \
    && uv pip install --python /opt/vllm-env/bin/python --torch-backend=cu128 torch==2.10.0

RUN --mount=type=cache,target=/tmp/uv-cache \
    uv pip install --python /opt/vllm-env/bin/python --torch-backend=cu128 vllm==0.19.1 torch==2.10.0

RUN --mount=type=cache,target=/tmp/uv-cache \
    uv venv --python 3.10 /opt/popper-env \
    && uv pip install --python /opt/popper-env/bin/python torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install --python /opt/popper-env/bin/python --no-deps git+https://github.com/snap-stanford/POPPER.git@59611864e09dd15d7528e240ad87c7ddbb4a701c

COPY popper_upgrade/requirements.txt popper_upgrade/constraints-popper-env.txt /opt/popper/popper_upgrade/
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv pip install --python /opt/popper-env/bin/python -r /opt/popper/popper_upgrade/requirements.txt -c /opt/popper/popper_upgrade/constraints-popper-env.txt \
    && SENTENCE_TRANSFORMERS_HOME=/opt/popper/st /opt/popper-env/bin/python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY popper_upgrade /opt/popper/popper_upgrade
COPY cluster /opt/popper/cluster
COPY baseline_experiment/config.py baseline_experiment/popper_common.py /opt/popper/baseline_experiment/
RUN rm -rf /opt/popper/popper_upgrade/app /opt/popper/popper_upgrade/tests \
    && mkdir -p /opt/popper/data/bio_database \
    && chmod -R a+rX /opt/popper /opt/popper-env /opt/vllm-env /opt/uv-python

ENV PYTHONNOUSERSITE=1 \
    PYTHONPATH=/opt/popper \
    POPPER_IMAGE=qwen \
    POPPER_VLLM_PYTHON=/opt/vllm-env/bin/python \
    SENTENCE_TRANSFORMERS_HOME=/opt/popper/st

WORKDIR /work
