Bootstrap: docker
From: nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

%labels
    Author      POPPER Gender Bias Experiment
    Version     1.1
    Description vLLM + POPPER + Llama 3.1 70B on A100 (pinned build, see requirements.txt)

%post
    # System packages
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        python3-setuptools \
        git \
        wget \
        curl \
        ca-certificates
    rm -rf /var/lib/apt/lists/*

    pip3 install --upgrade pip

    # torch pinned to vLLM 0.7.3's exact required, cu121-available versions
    pip3 install torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu121

    # vllm 0.7.3 pinned for openai/pydantic compatibility with POPPER's pins below
    pip3 install vllm==0.7.3

    pip3 install huggingface_hub[hf_xet]==0.30.0 transformers==4.51.3 accelerate==1.5.2

    # --no-deps so pip doesn't re-resolve and drift the pins below
    # (gradio dropped: only used by launch_UI(), never called here, and it forces huggingface_hub past what transformers needs)
    pip3 install --no-deps git+https://github.com/snap-stanford/POPPER.git
    pip3 install \
        pydantic==2.9.2 \
        openai==1.61.0 \
        anthropic==0.40.0 \
        langchain_core==0.3.22 \
        langchain_openai==0.2.11 \
        langchain_anthropic==0.2.3 \
        langchain==0.3.7 \
        langgraph==0.2.39 \
        langchain_experimental==0.3.3 \
        chromadb \
        sentence-transformers==3.3.1 \
        numpy==1.26.4 \
        scipy==1.13.1 \
        scikit-learn tqdm pandas ipython

    pip3 install python-docx

    pip3 cache purge

%environment
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

    # Set HF_TOKEN on the host before running for gated models
    export HUGGING_FACE_HUB_TOKEN=${HF_TOKEN:-""}

    export HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
    export TRANSFORMERS_CACHE=${HF_HOME}/transformers

    export VLLM_WORKER_MULTIPROC_METHOD=spawn

%runscript
    echo "POPPER + vLLM container"
    echo "Usage:"
    echo "  Start vLLM server : singularity exec --nv popper_llama.sif vllm serve meta-llama/Llama-3.1-70B-Instruct --port 8000 --host 0.0.0.0 --dtype bfloat16"
    echo "  Run experiment    : singularity exec --nv popper_llama.sif python3 test3_local.py"
    exec "$@"

%test
    python3 -c "import torch; print('PyTorch:', torch.__version__); print('CUDA available:', torch.cuda.is_available())"
    python3 -c "import vllm; print('vLLM: OK')"
    python3 -c "import popper; print('POPPER: OK')"
    python3 -c "import pandas, docx; print('pandas + python-docx: OK')"
