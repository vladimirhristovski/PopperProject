FROM python:3.10-slim@sha256:6ff506466f8b1e981719b468cc0023b8ef000b983cdec0eafe119d01f379e31d

WORKDIR /app

RUN useradd --create-home --uid 1000 app \
    && chown app:app /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
    && pip install --no-deps git+https://github.com/snap-stanford/POPPER.git@59611864e09dd15d7528e240ad87c7ddbb4a701c

RUN pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu

COPY popper_upgrade/requirements.txt /tmp/popper-requirements.txt
COPY popper_upgrade/requirements-app.txt /tmp/popper-requirements-app.txt
RUN pip install -r /tmp/popper-requirements.txt -r /tmp/popper-requirements-app.txt

COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN pip install -r /tmp/requirements-dev.txt

USER app

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY --chown=app:app pyproject.toml /app/pyproject.toml
COPY --chown=app:app popper_upgrade/ /app/popper_upgrade/
COPY --chown=app:app cluster/ /app/cluster/
COPY --chown=app:app local/ /app/local/
COPY --chown=app:app baseline_experiment/config.py baseline_experiment/popper_common.py baseline_experiment/test3_local.py /app/baseline_experiment/

CMD ["python", "-m", "pytest", "popper_upgrade/tests/", "-v", "--cov"]
